# Banco de dados (Drizzle ORM + PostgreSQL)
# Dentro do Easypanel, use o host interno do serviço de banco:
DATABASE_URL="postgres://postgres:senha@sistema_bancoshark:5432/sistema?sslmode=disable"
# Em banco gerenciado na internet, troque para sslmode=require.
# Para rodar na sua máquina com Docker:
# docker run -d --name shark-pg -e POSTGRES_PASSWORD=senha -p 5432:5432 postgres:16
# DATABASE_URL="postgres://postgres:senha@127.0.0.1:5432/postgres"

# Chave que assina o cookie de sessão do painel.
# Gere uma nova com: openssl rand -base64 32
SESSION_SECRET="troque-esta-chave-por-uma-aleatoria-de-32-caracteres"

# Usuário e senha iniciais do painel.
ADMIN_USER="vanessa"
ADMIN_PASSWORD="troque-esta-senha"

# Pasta onde ficam os currículos enviados (fora da pasta pública, por LGPD).
# Em produção aponte para dentro do volume: UPLOADS_DIR="/app/data/uploads"
UPLOADS_DIR="./uploads"
