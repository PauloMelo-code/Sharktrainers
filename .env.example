# Banco de dados (Drizzle ORM + libSQL)
# Arquivo local, padrão de desenvolvimento — não precisa instalar nada:
DATABASE_URL="file:./dev.db"
# Em produção com volume (Easypanel, Docker, VPS), use caminho absoluto:
# DATABASE_URL="file:/app/data/dev.db"
# Turso (SQLite hospedado, funciona na Vercel):
# DATABASE_URL="libsql://sharktrainers-usuario.turso.io"
# DATABASE_AUTH_TOKEN="token-gerado-pelo-turso"

# Chave que assina o cookie de sessão do painel.
# Gere uma nova com: openssl rand -base64 32
SESSION_SECRET="troque-esta-chave-por-uma-aleatoria-de-32-caracteres"

# Usuário e senha iniciais do painel (usados apenas pelo seed).
ADMIN_USER="vanessa"
ADMIN_PASSWORD="shark2026"

# Pasta onde ficam os currículos enviados (fora da pasta pública, por LGPD).
# Em produção aponte para dentro do volume: UPLOADS_DIR="/app/data/uploads"
UPLOADS_DIR="./uploads"
